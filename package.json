{
  "name": "claude-usage-widget",
  "version": "1.0.0",
  "description": "Zwevende widget die je Claude-gebruikslimieten (5-uurs en wekelijks) toont en automatisch start met Claude Code.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "launch": "node bin/launch.js",
    "install-hook": "node scripts/hook.js install",
    "uninstall-hook": "node scripts/hook.js uninstall",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "electron": "^44.9.3"
  }
}
